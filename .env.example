DATA_DIR=./data
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragpodcast
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5433/ragpodcast
EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Absolute path to the host's cache root (parent of huggingface/modelscope/
# torch subdirs), bind-mounted into the worker container so model weights
# already on disk aren't re-downloaded. docker compose reads this from .env
# directly (shell-independent, unlike ${HOME}/${USERPROFILE}).
# Windows: C:/Users/<you>/.cache   Linux/macOS: /home/<you>/.cache (or $HOME/.cache)
HOST_CACHE_DIR=
